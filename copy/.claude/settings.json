{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 90,
  "env": {
    "WORK_IMPLEMENTER_MODEL": "sonnet",
    "WORK_REVIEWER_MODEL": "inherit",
    "WORK_RESEARCH_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree remove:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr diff:*)",
      "Bash(glab mr list:*)",
      "Bash(glab repo list:*)",
      "Bash(glab ci status:*)",
      "Bash(acli jira workitem view:*)",
      "Bash(acli jira workitem search:*)",
      "Bash(jira issue view:*)",
      "Bash(jira issue list:*)",
      "Bash(printenv:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(/usr/bin/curl:*)",
      "Bash(/opt/homebrew/bin/curl:*)",
      "Bash(wget:*)",
      "Bash(/opt/homebrew/bin/wget:*)",
      "Bash(nc:*)",
      "Bash(/usr/bin/nc:*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*credential*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)"
    ],
    "additionalDirectories": [
      "~/workspaces/worktrees"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/repo-rules.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/repo-rules.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline.sh",
    "refreshInterval": 30
  },
  "theme": "custom:aura-pane"
}
